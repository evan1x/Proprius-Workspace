{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.ollama" },
        { "path": "$HOME/.ollama/**" },
        { "path": "$HOME/.ollama/models" },
        { "path": "$HOME/.ollama/models/**" }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "allow-open-terminal",
    "allow-fetch-ollama-html",
    "allow-get-hardware-info"
  ]
}
